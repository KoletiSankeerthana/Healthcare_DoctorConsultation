# =============================================================================
# MediVerse / HEALVIA Healthcare Platform - Environment Variables Template
# =============================================================================

# --- Backend Server Configuration ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# --- Backend Database & Security Configuration ---
# PostgreSQL connection format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local SQLite development (default):
DATABASE_URL=sqlite:///./backend/healthcare_records.db
SECRET_KEY=your_secure_secret_key_here

# --- Frontend Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Google Maps & Places Geocoding API ---
# Optional: If configured, enables live Google Places Autocomplete and Geocoding.
# If omitted, HEALVIA automatically falls back to curated Indian metropolitan geo-cache.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_key_here

# --- Storage Configuration ---
UPLOAD_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Emergency Contact Information ---
NEXT_PUBLIC_EMERGENCY_NUMBER=112
NEXT_PUBLIC_AMBULANCE_NUMBER=108

# =============================================================================
# Payment Configuration
# Options: 'mock' (Test/Dummy mode for testing without Razorpay checkout) | 'razorpay' (Real Razorpay gateway)
# =============================================================================
PAYMENT_MODE=mock

# =============================================================================
# Razorpay Payment Gateway Integration (Test Mode & Production)
# =============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# =============================================================================
# Gmail OAuth 2.0 Integration & Automated Notifications
# =============================================================================
# Google Cloud Console Web Client Credentials
# Authorized Redirect URI configured in Google Console: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Verified sender email address (The Admin Gmail account authorized via OAuth)
GMAIL_SENDER_EMAIL=your_admin_email@gmail.com

# Administrator alert destination for new doctor registrations and governance notices
ADMIN_NOTIFICATION_EMAIL=your_admin_email@gmail.com

