# =============================================================================
# MediVerse Healthcare Platform - Git Ignore Rules
# =============================================================================

# Environment variables and secrets
.env
.env.*
.env.local
.env.development
.env.production
!.env.example
!.env.template

# Credentials, tokens, keys and service accounts
*credentials*.json
*client_secret*.json
*service_account*.json
*token*.json
backend/storage/tokens/
*.pem
*.key
*.p12
*.pfx

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/

# Build outputs
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Local databases and database backups
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-journal
*.bak
backend/healthcare_records.db

# User uploads, runtime storage and scratch files
uploads/
backend/storage/
scratch/

# Logs
*.log

# IDE and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
